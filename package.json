{
  "name": "claude-code-monitor",
  "displayName": "Claude/codex Monitor 本機監控",
  "description": "Claude 與 Codex 動態大腦流程桌布，主／子代理獨立、所有來源共用一組裝甲手腳輸出：唯讀本機逐字稿。",
  "version": "0.5.14",
  "publisher": "toperking",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/toperking/claude-code-monitor.git"
  },
  "homepage": "https://github.com/toperking/claude-code-monitor#readme",
  "bugs": {
    "url": "https://github.com/toperking/claude-code-monitor/issues"
  },
  "keywords": [
    "claude",
    "claude code",
    "monitor",
    "flow",
    "usage",
    "本機監控"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeMonitor.show",
        "title": "Claude/codex Monitor: 顯示側邊欄",
        "icon": "$(pulse)"
      },
      {
        "command": "claudeMonitor.open",
        "title": "Claude/codex Monitor: 在編輯區開啟（較大）",
        "icon": "$(link-external)"
      },
      {
        "command": "claudeMonitor.ragMenu",
        "title": "Claude/codex Monitor: RAG 資料庫設定（選資料夾、套用）",
        "icon": "$(gear)"
      },
      {
        "command": "claudeMonitor.pickRagDbFolder",
        "title": "Claude/codex Monitor: 選擇 RAG 資料庫的資料夾…"
      },
      {
        "command": "claudeMonitor.openRagSettings",
        "title": "Claude/codex Monitor: 開啟 RAG 設定頁"
      },
      {
        "command": "claudeMonitor.applyRagDb",
        "title": "Claude/codex Monitor: 套用 RAG 資料庫位置（搬移並重新註冊）"
      },
      {
        "command": "claudeMonitor.installRagMcpSkill",
        "title": "Claude/codex Monitor: 產生並安裝 RAG 技能"
      }
    ],
    "configuration": {
      "title": "Claude/codex Monitor",
      "properties": {
        "claudeMonitor.codexEnabled": {
          "type": "boolean",
          "default": true,
          "description": "同時監看本機 Codex 任務與工具狀態（唯讀），在同一張桌布上依來源分列。"
        },
        "claudeMonitor.codexHome": {
          "type": "string",
          "default": "",
          "description": "Codex 資料夾，內含 sessions。留空使用 CODEX_HOME，未設定則使用 ~/.codex。"
        },
        "claudeMonitor.claudeHome": {
          "type": "string",
          "default": "",
          "description": "Claude Code 資料夾。留空＝使用者目錄下的 .claude。只會讀取，不會寫入。"
        },
        "claudeMonitor.refreshSeconds": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 30,
          "description": "多久重新掃描一次逐字稿（秒）。"
        },
        "claudeMonitor.bubbles": {
          "type": "boolean",
          "default": true,
          "description": "顯示說明泡泡（工具開始、失敗、讀寫 .md 文件、子代理出現等）。"
        },
        "claudeMonitor.freeIdle": {
          "type": "boolean",
          "default": true,
          "description": "機器人沒事做時自己隨機活動（揮手、對空出拳、巡邏、坐下）；關閉就只依真實事件動作。"
        },
        "claudeMonitor.maxFps": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "maximum": 60,
          "description": "流程圖每秒最多重畫幾張。調低可以減少 CPU／GPU 負擔；畫面完全靜止時（沒有 AI 在執行）自動降到每秒一張。"
        },
        "claudeMonitor.ragDbPath": {
          "type": "string",
          "default": "",
          "order": 100,
          "markdownDescription": "**RAG 資料庫的新位置**（完整路徑，例如 `D:\\RagData\\rag.db`；留空＝預設的 `%LOCALAPPDATA%\\LocalRag\\rag.db`）。\n\n不想手打路徑？按 [選擇資料夾…](command:claudeMonitor.pickRagDbFolder) 跳出資料夾挑選器，選好會自動填入。\n\n只改這個設定**不會**有任何動作；要執行請按 [套用 RAG 資料庫位置](command:claudeMonitor.applyRagDb)。套用時會先顯示計畫並請你確認，然後：① 把資料庫（含備份）**搬**過去（剪下貼上，不留舊檔）；② 用 `claude mcp` 重新註冊 local-rag，加上 `RAG_DB`。資料庫使用中會拒絕並且什麼都不動；任何一步失敗都會還原。"
        },
        "claudeMonitor.ragServerName": {
          "type": "string",
          "default": "local-rag",
          "order": 101,
          "description": "Claude Code 裡 RAG MCP 伺服器的名稱（使用者範圍）。"
        },
        "claudeMonitor.ragClaudeCommand": {
          "type": "string",
          "default": "claude",
          "order": 102,
          "description": "重新註冊時執行的 claude 命令。找不到時請填完整路徑，例如 C:\\Users\\你\\.local\\bin\\claude.exe。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeMonitor",
          "title": "Claude/codex Monitor",
          "icon": "resources/activity.svg"
        }
      ]
    },
    "views": {
      "claudeMonitor": [
        {
          "type": "webview",
          "id": "claudeMonitor.view",
          "name": "本機監控"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "claudeMonitor.open",
          "when": "view == claudeMonitor.view",
          "group": "navigation"
        },
        {
          "command": "claudeMonitor.ragMenu",
          "when": "view == claudeMonitor.view",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run typecheck && npm run build && vsce package --no-dependencies",
    "harness": "node test/serve.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "icon": "resources/icon.png"
}
